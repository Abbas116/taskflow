PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/taskflow
JWT_SECRET=change_this_to_a_long_random_string
# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# --- Only needed on Vercel (or when running several server instances) ---
# Redis connection string (Upstash / Vercel Marketplace Redis). Leave empty for local development.
REDIS_URL=
# Secret used by the daily Vercel Cron job (any long random string)
CRON_SECRET=
